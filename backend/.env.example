# Kredensial Administrator Epiona (wajib disetel, jangan hardcode di kode)
ADMIN_EMAIL=admin@epiona.my.id
ADMIN_PASSWORD=change_this_admin_password_in_production
# ADMIN_PASSWORD_HASH= (opsional, jika ingin menyediakan hash langsung)

# Keamanan Autentikasi JWT (wajib disetel acak minimal 32 karakter di produksi)
JWT_SECRET=change_this_jwt_secret_key_minimum_32_characters_random
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24


# Batasan Upload & Proteksi DoS & Rate Limit
MAX_UPLOAD_MB=25
WEB_MODE_RATE_LIMIT_PER_MINUTE=10
MAX_WEB_QUOTA_PER_DAY=50

# Whitelist CORS (Pisahkan koma, jangan gunakan '*' bersama credentials)
CORS_ORIGINS=http://localhost:3000

# OCR Opsional (pytesseract untuk halaman PDF tanpa teks)
OCR_ENABLED=false

# Model Gateway & Direct Claude (Anthropic / OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5

# Masukkan API Key Groq Anda di sini (opsional saat pengujian lokal)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant

# Model Embedding & Reranker Multibahasa (Opsional untuk RAG Hybrid & RRF)
# Kosongkan untuk fallback ke BM25 leksikal murni jika sentence-transformers tidak dipasang
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Academic & Web Search Engine Configuration (P3-1)
SEARCH_PROVIDERS=pubmed,semantic_scholar,europepmc,openfda_label,tavily
TAVILY_API_KEY=
NCBI_API_KEY=
CLAIM_CHECK=1
SEARCH_CACHE_TTL=86400



